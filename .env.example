# BasseyFlow — Supabase configuration
#
# Copy this file to `.env` in the project root and replace the placeholders
# with values from your Supabase project:
#   https://app.supabase.com → Project → Settings → API
#
# NEVER commit a real `.env` file. Only the anon (public) key is safe to use
# in frontend code. The service_role key must NEVER appear in this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
